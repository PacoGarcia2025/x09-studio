# Ambiente — copiar para .env.local (dev) e /opt/x09-studio/.env (VPS)
# Projeto Supabase EXCLUSIVO do X09 Studio.
# Use as API keys ATUAIS (publishable + secret). Não use Legacy anon/service_role JWTs.

# App
NODE_ENV=production
PORT=3001
HOSTNAME=127.0.0.1
NEXT_PUBLIC_APP_URL=https://studio.x09.com.br
NEXT_PUBLIC_VISUAL_MVP_URL=https://studio.x09.com.br
CORS_ALLOWED_ORIGINS=https://studio.x09.com.br,http://localhost:5173

# Paths portáteis (migração de VPS só muda estes valores)
STUDIO_PROJECTS_ROOT=/var/lib/x09-studio/projects
# Biblioteca de assets (irmã de projects). Se vazio, usa <pai de projects>/assets
STUDIO_ASSETS_ROOT=/var/lib/x09-studio/assets
# Raiz do código do Studio (VPS: /opt/x09-studio). Opcional — auto-detecta templates/.
STUDIO_APP_ROOT=/opt/x09-studio
STUDIO_PUBLISH_ROOT=/var/lib/x09-studio/published
# Build estático SSG no publish → Nginx serve esta pasta por subdomínio
STUDIO_STATIC_CLIENTS_ROOT=/var/www/html/clients
STUDIO_PUBLISH_DOMAIN=studio.x09.com.br
NEXT_PUBLIC_PUBLISH_DOMAIN=studio.x09.com.br
# Ative só após certificado wildcard *.studio.x09.com.br no nginx
# STUDIO_PUBLISH_SUBDOMAIN_SSL=true
# NEXT_PUBLIC_PUBLISH_SUBDOMAIN_SSL=true
STUDIO_DOCKER_NETWORK=x09-studio-preview
STUDIO_PREVIEW_IDLE_MS=1800000

# Supabase — plataforma Studio
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STUDIO_PROJECT.supabase.co

# Chave pública (Publishable Key: sb_publishable_...)
# Nome canônico novo: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Alias aceito pelo código: NEXT_PUBLIC_SUPABASE_ANON_KEY (mesmo valor publishable)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Auth social (ligar no painel Authentication > Providers do Supabase)
# Redirect URL produção: https://studio.x09.com.br/auth/callback
# Redirect URL local: http://localhost:3000/auth/callback
# Google (P1): ativar o provider Google com Client ID/Secret do Google Cloud.
# Facebook (P3): só depois do App Review. Para mostrar o botão:
# NEXT_PUBLIC_AUTH_FACEBOOK=1
#   https://studio.x09.com.br/legal/termos
#   https://studio.x09.com.br/legal/privacidade

# Suporte (billing, LGPD, reembolso)
STUDIO_SUPPORT_EMAIL=studio@x09.com.br

# Chave secreta backend (Secret Key: sb_secret_...) — NUNCA no browser
# Nome canônico novo: SUPABASE_SECRET_KEY
# Alias aceito: SUPABASE_SERVICE_ROLE_KEY (mesmo valor secret)
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# LLM — modelos ativos (somente no servidor / PM2 — NUNCA VITE_*)
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
MISTRAL_API_KEY=your-mistral-api-key
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key
# Alias aceito pelo sidecar TRELLIS: HUGGINGFACE_TOKEN, HF_TOKEN ou HUGGING_FACE_HUB_TOKEN
TOGETHER_API_KEY=your-together-api-key
XAI_API_KEY=your-xai-api-key

# Visual MVP (Vite) — só Supabase anon + URL do BFF (vazio = proxy /api)
# VITE_API_BASE=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# ─── Billing Mercado Pago (Checkout Pro / pacotes de créditos) ───
# Nome do Studio. O site x09 usa MERCADO_PAGO_ACCESS_TOKEN — os dois valem.
MP_ACCESS_TOKEN=APP_USR-...
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=your-mp-webhook-secret
# MERCADO_PAGO_WEBHOOK_SECRET=...
# Somente em testes locais sem assinatura: MP_WEBHOOK_SKIP_VERIFY=1
# Webhook: https://studio.x09.com.br/api/webhooks/mercadopago

# ─── GitHub App (sync de repositório) ───
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=x09-studio
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
# Somente em testes locais: GITHUB_WEBHOOK_SKIP_VERIFY=1
# Callback da App: https://studio.x09.com.br/api/github/callback
# Webhook: https://studio.x09.com.br/api/github/webhook

# ─── Vercel Deploy API ───
VERCEL_TOKEN=your-vercel-token
VERCEL_TEAM_ID=
VERCEL_WEBHOOK_SECRET=your-vercel-webhook-secret
VERCEL_PROJECT_NAME_PREFIX=x09
# Somente em testes locais: VERCEL_WEBHOOK_SKIP_VERIFY=1
# Webhook: https://studio.x09.com.br/api/webhooks/vercel

# E-mail
RESEND_API_KEY=re_...
# Remetente verificado no Resend (free tier)
RESEND_FROM_EMAIL=Leads X09 <leads@seudominio.com.br>
# Fallback quando imóvel não tem brokerEmail
STUDIO_LEADS_FALLBACK_EMAIL=corretor@example.com

# Domínios, CDN e storage
CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=x09-studio

# ─── Assets / fila / storage ───
# Driver: local | supabase | s3 | r2 | minio | azure | gcs
STUDIO_ASSET_STORAGE=local
# Processor da fila (não é motor de IA): local | future
STUDIO_ASSET_PROCESSOR=local
# Worker isolado (Fase 3). Não carrega modelos.
# npm run asset-worker
# ASSET_WORKER_PORT=3040
# ASSET_WORKER_POLL_MS=2000
# STUDIO_ASSET_WORKER_SECRET=change-me
# STUDIO_AI_ENGINE_WORKER_URL=http://127.0.0.1:3040
# Reenfileira jobs stuck em running/retrying (ms). Qualquer capability.
STUDIO_ASSET_JOB_STALE_MS=2400000

# ─── Capability Router / políticas ───
# mesh.generate (fake-mesh) exige geração ligada. Sem GPU o Router não escolhe TRELLIS.
STUDIO_AI_ENGINE_GENERATION_ENABLED=false
STUDIO_ASSET_GPU_AVAILABLE=false
STUDIO_ASSET_PAID_APIS=false
# STUDIO_ASSET_INTERNET=true
# Malha comercial (image→GLB, volume fechado). Exige STUDIO_ASSET_PAID_APIS=true.
# STUDIO_MESHY_API_KEY=
# Sidecar do Provider TRELLIS (não é variável do Router / Core)
# STUDIO_TRELLIS_PYTHON=/opt/conda/envs/trellis/bin/python
# STUDIO_TRELLIS_ROOT=/opt/x09-studio/services/trellis-worker/vendor/TRELLIS
# STUDIO_TRELLIS_MODEL=microsoft/TRELLIS-image-large
# STUDIO_TRELLIS_WEIGHTS=
# STUDIO_TRELLIS_TIMEOUT_MS=1800000
# GPU RunPod sob demanda.
# Preferir network volume: cada job CRIA um 4090, TERMINATE no fim; o sidecar fica no disco.
# A imagem Docker tem de ficar pinada (o Python do volume usa o PyTorch desta tag):
# runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04
# Sem volume, START/STOP do pod fixo (preso ao mesmo host — pode falhar se a máquina estiver cheia).
# Exige também STUDIO_ASSET_GPU_AVAILABLE=true para o Router escolher o TRELLIS.
# STUDIO_RUNPOD_API_KEY=
# STUDIO_RUNPOD_NETWORK_VOLUME_ID=
# STUDIO_RUNPOD_DATACENTER=EU-RO-1
# STUDIO_RUNPOD_POD_ID=
# STUDIO_RUNPOD_SSH_KEY=.runpod-ssh/trellis_ed25519
# STUDIO_RUNPOD_STOP_AFTER_JOB=true
# STUDIO_RUNPOD_START_TIMEOUT_MS=300000

# Observabilidade
SENTRY_DSN=https://...
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Bootstrap do primeiro owner (não versionar valores reais)
# Este e-mail vê Recursos e Conectores no menu; os clientes não.
# Em npm run dev, se esta linha estiver vazia, o login atual já conta como operador.
# Em produção (NODE_ENV=production) este e-mail é obrigatório — sem ele o menu
# Recursos/Conectores some para toda a gente, inclusive você.
STUDIO_OWNER_EMAIL=owner@example.com
STUDIO_OWNER_PASSWORD=change-me
# Extra (opcional): STUDIO_OPERATOR_EMAILS=ops@x09.com.br
